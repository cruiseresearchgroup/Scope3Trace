# Search Agent report search. Default backend: an LLM with OpenRouter web search
# (uses OPENROUTER_API_KEY below); optional: Google Custom Search JSON API.
SCOPE3TRACE_SEARCH_BACKEND=openrouter
SCOPE3TRACE_SEARCH_MODEL=openai/gpt-4o-mini
SCOPE3TRACE_SEARCH_ENGINE=exa
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# LLM backbones (OpenAI-compatible chat-completions endpoints). Fill in the ones you use.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# OpenRouter: report search (default backend) and vendor-prefixed model ids such as google/gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Chart / image reader. Default: gemini-2.5-flash through the Gemini API (GEMINI_API_KEY).
# Set google/gemini-2.5-flash to run the same model through OpenRouter (OPENROUTER_API_KEY) instead.
# SCOPE3TRACE_CHART_MODEL=gemini-2.5-flash
# Optional: route every model through one endpoint
# SCOPE3TRACE_BASE_URL=
# SCOPE3TRACE_API_KEY=
